# ------------------------------------------------------------------
# Copy to .env and fill in. Values prefixed PUBLIC_ are inlined into
# the client bundle; everything else stays on the server.
# ------------------------------------------------------------------

# Canonical site URL, no trailing slash. [SITE URL: confirm once silicon-partner.com is registered]
PUBLIC_SITE_URL=https://silicon-partner.com

# --- Analytics (each tag is disabled while its ID is empty) ---------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_MEASUREMENT_ID=
# Google Ads conversion ID, e.g. AW-123456789
PUBLIC_GOOGLE_ADS_CONVERSION_ID=
# Google Ads conversion labels (one per conversion action)
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
PUBLIC_GOOGLE_ADS_BOOKING_LABEL=
# LinkedIn Insight Tag partner ID and conversion IDs
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
PUBLIC_LINKEDIN_BOOKING_CONVERSION_ID=

# --- Calendar booking (Cal.com or Calendly public link) -------------
# [CALENDAR URL]
PUBLIC_CALENDAR_URL=

# --- Spam protection: Cloudflare Turnstile (optional, recommended) --
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CRM: HubSpot Forms API (primary) ------------------------------
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# --- CRM fallback: generic JSON webhook (Zapier, Make, Pipedrive...) -
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Internal notification on each lead (Slack/Teams incoming webhook)
LEAD_NOTIFY_WEBHOOK_URL=

# Reject free-mail addresses (gmail.com, outlook.com, ...) on the lead form.
REQUIRE_WORK_EMAIL=true

# Render [PLACEHOLDER: ...] text with a visible highlight. Set false for launch.
PUBLIC_SHOW_PLACEHOLDERS=true
