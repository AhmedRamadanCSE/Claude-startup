---
import Copy from './Copy.astro';
import type { CollectionEntry } from 'astro:content';
import { routes } from '../lib/routes.ts';
import { localizePath } from '../i18n/index.ts';
import { splitEntryId, formatDate } from '../lib/format.ts';

interface Props {
  entry: CollectionEntry<'insights'>;
  areaName: string;
  locale?: string;
  readingLabel: string;
}

const { entry, areaName, locale = 'en', readingLabel } = Astro.props;
const { slug } = splitEntryId(entry.id);
const href = localizePath(routes.insight(slug), locale);
---

<article class="card card--interactive art-card">
  <div class="cluster art-card__meta mono">
    <span class="badge badge--accent">{areaName}</span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, locale)}</time>
    <span>{readingLabel}</span>
  </div>
  <h3 class="card__title"><a href={href} data-astro-prefetch>{entry.data.title}</a></h3>
  <p class="card__body">{entry.data.description}</p>
  <p class="art-card__author faint"><Copy text={entry.data.author} />{entry.data.authorRole && <span> · {entry.data.authorRole}</span>}</p>
</article>

<style>
  .art-card__meta {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .art-card__author {
    font-size: var(--text-xs);
    margin-block-start: auto;
  }
</style>
