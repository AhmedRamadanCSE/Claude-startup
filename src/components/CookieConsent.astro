---
import { getDictionary } from '../i18n/index.ts';
import { routes } from '../lib/routes.ts';

interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const t = getDictionary(locale ?? Astro.currentLocale).common.consent;
---

<div id="consent-banner" class="consent" role="region" aria-label={t.ariaLabel} hidden>
  <div class="consent__inner">
    <div class="consent__text">
      <p class="consent__title">{t.title}</p>
      <p class="consent__body">{t.body} <a href={routes.cookies}>{t.settings}</a></p>
    </div>
    <div class="consent__actions">
      <button type="button" class="consent__btn consent__btn--primary" data-consent="all">{t.accept}</button>
      <button type="button" class="consent__btn" data-consent="essential">{t.reject}</button>
    </div>
  </div>
</div>

<script src="../scripts/consent.ts"></script>

<style>
  .consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-overlay);
    padding: var(--space-4);
    pointer-events: none;
  }

  .consent[hidden] {
    display: none;
  }

  .consent__inner {
    pointer-events: auto;
    max-width: 44rem;
    margin-inline: auto;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 48em) {
    .consent__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .consent__title {
    font-weight: 600;
    margin-block-end: var(--space-1);
  }

  .consent__body {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .consent__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .consent__btn {
    padding: 0.6rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .consent__btn--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
</style>
