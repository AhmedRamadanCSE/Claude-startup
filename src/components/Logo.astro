---
import { SITE } from '../site.config.ts';

interface Props {
  class?: string;
  showWordmark?: boolean;
}

const { class: className, showWordmark = true } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="26" height="26" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5" />
    <path d="M4 8 C 10 8, 10 20, 14 20 S 18 8, 24 8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    <path d="M4 20 C 10 20, 10 8, 14 8 S 18 20, 24 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
    <circle cx="14" cy="14" r="1.6" fill="var(--color-accent)" />
  </svg>
  {showWordmark && <span class="logo__word">{SITE.name}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text);
  }

  .logo__mark {
    flex: 0 0 auto;
  }

  .logo__word {
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
</style>
