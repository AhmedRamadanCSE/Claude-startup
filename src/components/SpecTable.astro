---
import Copy from './Copy.astro';

interface Props {
  rows: readonly { label: string; value: string }[];
  caption?: string;
  labelHead?: string;
  valueHead?: string;
  class?: string;
}

const { rows, caption, labelHead = 'Parameter', valueHead = 'Value', class: className } = Astro.props;
---

<div class:list={['spec-table', className]}>
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">{labelHead}</th>
        <th scope="col">{valueHead}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <Copy as="td" class="mono" text={row.value} />
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .spec-table {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    text-align: start;
    padding: var(--space-4) var(--space-5) 0;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-faint);
  }

  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: 0.7rem var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  thead th {
    border-top: 0;
  }

  tbody th {
    font-weight: 500;
    color: var(--color-text-muted);
    width: 38%;
  }

  td {
    color: var(--color-text);
    font-size: 0.9em;
  }
</style>
