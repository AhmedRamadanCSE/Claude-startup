---
import Copy from './Copy.astro';

interface Props {
  steps: readonly { title: string; body: string }[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<ol class:list={['steps', className]}>
  {
    steps.map((step, i) => (
      <li class="step">
        <span class="step__num mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="step__body">
          <Copy as="h3" class="step__title" text={step.title} />
          <Copy as="p" class="step__text" text={step.body} />
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
    counter-reset: step;
  }

  @media (min-width: 40em) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .step__num {
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .step__num::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin-block-start: var(--space-3);
    background: var(--color-accent-line);
  }

  .step__title {
    font-size: var(--text-lg);
    margin-block-end: var(--space-2);
  }

  .step__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }
</style>
