---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Copy from '../components/Copy.astro';
import Button from '../components/Button.astro';
import { getDictionary, localizePath } from '../i18n/index.ts';
import { routes } from '../lib/routes.ts';
import { SITE } from '../site.config.ts';
import { stripPlaceholderNotes } from '../lib/placeholders.ts';

const lang = Astro.currentLocale ?? 'en';
const dict = getDictionary(lang);
const t = dict.careers;
const c = dict.common;
const l = (p: string) => localizePath(p, lang);
const path = l(routes.careers);
const mailto = `mailto:${stripPlaceholderNotes(SITE.contact.careersEmail)}`;
---

<Base title={t.seo.title} description={t.seo.description} path={path} ogKey="careers">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: c.nav.careers, path }]} locale={lang} />
      <SectionHead as="h1" eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div>
        <h2 class="h2">{t.offer.title}</h2>
        <ul class="spec-list mt-8">
          {t.offer.items.map((i) => <Copy as="li" text={i} />)}
        </ul>
      </div>
      <div>
        <h2 class="h2">{t.rolesTitle}</h2>
        <ul class="roles mt-8" role="list">
          {t.roles.map((r) => (
            <li class="card">
              <h3 class="card__title">{r.title}</h3>
              <Copy as="p" class="card__body" text={r.summary} />
              <p class="mono faint role__loc">{r.location}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow stack">
      <h2 class="h2">{t.apply.title}</h2>
      <Copy as="p" class="lede" text={t.apply.body} />
      <p><Button href={mailto} size="lg">{t.apply.button}</Button></p>
      <p class="faint">{t.apply.note}</p>
    </div>
  </section>
</Base>

<style>
  .roles {
    display: grid;
    gap: var(--grid-gap);
  }

  .role__loc {
    font-size: var(--text-xs);
  }
</style>
