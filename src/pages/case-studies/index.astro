---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Copy from '../../components/Copy.astro';
import { getCollection } from 'astro:content';
import { getDictionary, localizePath } from '../../i18n/index.ts';
import { routes } from '../../lib/routes.ts';

const lang = Astro.currentLocale ?? 'en';
const dict = getDictionary(lang);
const t = dict.caseStudies;
const c = dict.common;
const l = (p: string) => localizePath(p, lang);
const path = l(routes.caseStudies);
const entries = (await getCollection('caseStudies', (e) => !e.data.draft && e.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
const areaName = (slug: string) => dict.capabilities.find((x) => x.slug === slug)?.name ?? slug;
const engagementName = (id: string) => dict.engagementModels.find((x) => x.id === id)?.name ?? id;
---

<Base title={t.seo.title} description={t.seo.description} path={path} ogKey="case-studies">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: c.nav.caseStudies, path }]} locale={lang} />
      <SectionHead as="h1" eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

      <div class="template grid grid--3">
        {t.template.items.map((item) => (
          <div class="template__item">
            <p class="eyebrow">{item.label}</p>
            <p class="muted">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="list-title">
    <div class="container">
      <h2 id="list-title" class="eyebrow">{t.listLabel}</h2>
      {entries.length ? (
        <div class="grid grid--3 mt-8">
          {entries.map((entry) => (
            <CaseStudyCard entry={entry} locale={lang} areaName={areaName(entry.data.area)} engagementName={engagementName(entry.data.engagement)} labels={{ challenge: c.labels.challenge, ourRole: c.labels.ourRole, result: c.labels.result, node: c.labels.node }} />
          ))}
        </div>
      ) : (
        <Copy as="p" class="mt-8 muted" text={t.empty} />
      )}
    </div>
  </section>

  <CtaBand title={t.cta.title} body={t.cta.body} primaryHref={l(routes.contact)} />
</Base>

<style>
  .template {
    margin-block-start: var(--space-2);
  }

  .template__item {
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-2);
  }
</style>
