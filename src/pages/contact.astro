---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Copy from '../components/Copy.astro';
import LeadForm from '../components/LeadForm.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import { getDictionary, localizePath } from '../i18n/index.ts';
import { routes } from '../lib/routes.ts';
import { SITE } from '../site.config.ts';

const lang = Astro.currentLocale ?? 'en';
const dict = getDictionary(lang);
const t = dict.contact;
const c = dict.common;
const l = (p: string) => localizePath(p, lang);
const path = l(routes.contact);
const jsonLd = [
  {
    '@type': 'ContactPage',
    name: t.hero.title,
    url: new URL(path, Astro.site ?? 'https://example.com').href,
  },
];
---

<Base title={t.seo.title} description={t.seo.description} path={path} ogKey="contact" jsonLd={jsonLd}>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: c.nav.contact, path }]} locale={lang} />
      <SectionHead as="h1" eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />

      <div class="contact split split--reverse">
        <aside class="contact__aside stack stack--lg">
          <div>
            <h2 class="h3">{t.next.title}</h2>
            <ol class="next" role="list">
              {t.next.steps.map((s, i) => (
                <li class="next__step">
                  <span class="mono next__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="h4">{s.title}</h3>
                    <Copy as="p" class="muted" text={s.body} />
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h2 class="h3">{t.direct.title}</h2>
            <dl class="direct">
              <dt>{t.direct.emailLabel}</dt>
              <Copy as="dd" text={SITE.contact.salesEmail} />
              <dt>{t.direct.phoneLabel}</dt>
              <Copy as="dd" text={SITE.contact.phone} />
              <dt>{t.direct.addressLabel}</dt>
              <dd><Copy text={SITE.location.address} />, {SITE.location.city}, {SITE.location.country}</dd>
              <dt>{t.direct.hoursLabel}</dt>
              <dd>{t.direct.hours}</dd>
            </dl>
          </div>
        </aside>
        <div class="contact__form">
          <LeadForm locale={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container container--narrow">
      <CalendarEmbed locale={lang} />
    </div>
  </section>
</Base>

<style>
  .contact {
    margin-block-start: var(--space-4);
  }

  @media (min-width: 56em) {
    .contact {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .next {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .next__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  .next__num {
    color: var(--color-accent);
    font-size: var(--text-sm);
    padding-top: 0.15em;
  }

  .next__step p {
    font-size: var(--text-sm);
  }

  .direct {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-4);
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
  }

  .direct dt {
    color: var(--color-text-faint);
  }

  .direct dd {
    margin: 0;
  }
</style>
