---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHead from '../components/SectionHead.astro';
import Copy from '../components/Copy.astro';
import CtaBand from '../components/CtaBand.astro';
import { getDictionary, localizePath } from '../i18n/index.ts';
import { routes } from '../lib/routes.ts';
import { serviceLd } from '../lib/seo.ts';
import Figure from '../components/graphics/Figure.astro';
import ClockWaveform from '../components/graphics/ClockWaveform.astro';

const lang = Astro.currentLocale ?? 'en';
const dict = getDictionary(lang);
const t = dict.engagementPage;
const c = dict.common;
const l = (p: string) => localizePath(p, lang);
const path = l(routes.engagement);
const jsonLd = dict.engagementModels.map((m) =>
  serviceLd(Astro.site, { path: `${path}#${m.id}`, name: m.name, description: m.short, serviceType: 'Analog and mixed-signal IC design services' }),
);
---

<Base title={t.seo.title} description={t.seo.description} path={path} ogKey="engagement-models" jsonLd={jsonLd}>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: c.nav.engagement, path }]} locale={lang} />
      <div class="split">
        <SectionHead as="h1" eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />
        <Figure title="LOCK · PFD · Δφ → 0">
          <ClockWaveform decorative />
        </Figure>
      </div>

      <nav class="jump cluster" aria-label="Engagement models">
        {dict.engagementModels.map((m, i) => (
          <a href={`#${m.id}`} class="badge"><span class="jump__num">{String(i + 1).padStart(2, '0')}</span> {m.name}</a>
        ))}
      </nav>
    </div>
  </section>

  {dict.engagementModels.map((m, i) => (
    <section class:list={['section', { 'section--tint': i % 2 === 0 }]} id={m.id} aria-labelledby={`${m.id}-title`}>
      <div class="container split">
        <div class="stack">
          <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
          <h2 id={`${m.id}-title`}>{m.name}</h2>
          <Copy as="p" class="lede" text={m.short} />
          <Copy as="p" class="muted example" text={m.example} />
        </div>
        <dl class="model">
          <div class="model__row">
            <dt>{t.labels.suits}</dt>
            <dd>
              <ul class="spec-list">
                {m.suits.map((s) => <Copy as="li" text={s} />)}
              </ul>
            </dd>
          </div>
          <div class="model__row">
            <dt>{t.labels.timeline}</dt>
            <Copy as="dd" class="mono model__mono" text={m.timeline} />
          </div>
          <div class="model__row">
            <dt>{t.labels.deliver}</dt>
            <dd>
              <ul class="spec-list">
                {m.deliver.map((d) => <li>{d}</li>)}
              </ul>
            </dd>
          </div>
          <div class="model__row">
            <dt>{t.labels.pricing}</dt>
            <Copy as="dd" text={m.pricing} />
          </div>
        </dl>
      </div>
    </section>
  ))}

  <section class="section" aria-labelledby="pricing-title">
    <div class="container split">
      <SectionHead eyebrow={t.pricing.eyebrow} title={t.pricing.title} lede={t.pricing.body} id="pricing-title" />
      <ol class="spec-list pricing-list">
        {t.pricing.items.map((item) => <Copy as="li" text={item} />)}
      </ol>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="compare-title">
    <div class="container">
      <h2 id="compare-title" class="h2">{t.compare.title}</h2>
      <div class="compare">
        <table>
          <thead>
            <tr>{t.compare.columns.map((col) => <th scope="col">{col}</th>)}</tr>
          </thead>
          <tbody>
            {t.compare.rows.map((row) => (
              <tr>{row.map((cell, ci) => (ci === 0 ? <th scope="row">{cell}</th> : <Copy as="td" class={ci === 2 ? 'mono' : undefined} text={cell} />))}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CtaBand title={t.cta.title} body={t.cta.body} primaryHref={l(routes.contact)} />
</Base>

<style>
  .jump {
    --cluster-gap: var(--space-2);
    margin-block-start: var(--space-2);
  }

  .jump a {
    text-decoration: none;
  }

  .jump__num {
    color: var(--color-accent);
  }

  .example {
    font-size: var(--text-sm);
  }

  .model {
    display: grid;
    gap: var(--space-6);
    margin: 0;
  }

  .model__row {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .model__row dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-faint);
  }

  .model__row dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .model__mono {
    font-size: var(--text-sm);
    color: var(--color-text) !important;
  }

  .pricing-list {
    font-size: var(--text-base);
    counter-reset: n;
  }

  .compare {
    overflow-x: auto;
    margin-block-start: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .compare table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .compare th,
  .compare td {
    text-align: start;
    padding: 0.8rem var(--space-5);
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }

  .compare thead th {
    border-top: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-faint);
    font-weight: 500;
  }

  .compare tbody th {
    font-weight: 600;
  }
</style>
