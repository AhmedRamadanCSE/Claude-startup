---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { getDictionary, localizePath } from '../../i18n/index.ts';
import { routes } from '../../lib/routes.ts';

const lang = Astro.currentLocale ?? 'en';
const dict = getDictionary(lang);
const t = dict.insights;
const c = dict.common;
const l = (p: string) => localizePath(p, lang);
const path = l(routes.insights);
const entries = (await getCollection('insights', (e) => !e.data.draft && e.id.startsWith(`${lang}/`))).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const areaName = (slug: string) => dict.capabilities.find((x) => x.slug === slug)?.name ?? 'General';
---

<Base title={t.seo.title} description={t.seo.description} path={path} ogKey="insights">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: c.nav.insights, path }]} locale={lang} />
      <SectionHead as="h1" eyebrow={t.hero.eyebrow} title={t.hero.title} lede={t.hero.lede} />
      <h2 class="eyebrow">{t.latest}</h2>
      <div class="grid grid--3 mt-4">
        {entries.map((entry) => <ArticleCard entry={entry} locale={lang} areaName={areaName(entry.data.area)} readingLabel={c.labels.readingTime(entry.data.readingMinutes)} />)}
      </div>
    </div>
  </section>

  <CtaBand title={t.cta.title} body={t.cta.body} primaryHref={l(routes.contact)} />
</Base>
